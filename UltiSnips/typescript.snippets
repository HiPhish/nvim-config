snippet import "Import statement"
import {${2:identifier}} from ${1:package};
endsnippet

snippet var: "Variable definition (typed)"
var ${1:name}: ${2:type} = ${3:value};
endsnippet

snippet let: "Variable definition (typed)"
let ${1:name}: ${2:type} = ${3:value};
endsnippet

snippet const: "Constant definition (typed)"
const ${1:name}: ${2:type} = ${3:value};
endsnippet
