snippet for "numeric for loop"
for ${1:i} = ${2:first}, ${3:last}, ${4:step} do
	$0
end
endsnippet

snippet fori "pair for loop"
for ${1:idx}, ${2:val} in pairs(${3:table_name}) do
	$0
end
endsnippet

snippet fori "ipair for loop"
for ${1:idx}, ${2:val} in ipairs(${3:table_name}) do
	$0
end
endsnippet
