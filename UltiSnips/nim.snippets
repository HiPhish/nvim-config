snippet proc "Procedure definition" b
proc ${1:name}(${2:parameter})${3:: ${4:returnType}} =
	${0:discard}
endsnippet

snippet func "Function definition" b
func ${1:name}(${2:parameter})${3:: ${4:returnType}} =
	${0:discard}
endsnippet

snippet iterator "Iterator definition" b
iterator ${1:name}(${2:parameter})${3:: ${4:returnType}} =
	${0:discard}
endsnippet

snippet const "Compile-time constant" b
const ${1:name}${2:: ${3:type}} = ${0:value}
endsnippet

snippet let "Runtime constant" b
let ${1:name}${2:: ${3:type}} = ${0:value}
endsnippet

snippet var "Runtime variable" b
var ${1:name}${2:: ${3:type}} = ${0:value}
endsnippet

snippet block "Block statement" b
block${1: ${2:name}}:
	${0:discard}
endsnippet

snippet for "For-loop" b
for ${1:binding} in ${2:iterator}:
	${0:discard}
endsnippet

snippet while "While-loop" b
while ${1:condition}:
	${0:discard}
endsnippet

snippet if "If-block" b
if ${1:condition}:
	${0:discard}
endsnippet

snippet when "Compile-time condition" b
when ${1:condition}:
	${0:discard}
endsnippet
