snippet func "Function" b
function! ${1:name}(${2})
	${0:" body}
endfunction
endsnippet

snippet for "For loop" b
for ${1:var} in ${2:collection}
	${0:" body}
endfor
endsnippet

snippet while "While loop" b
while ${1:condition}
	${0:" body}
endwhile
endsnippet

snippet if "If statement" b
if ${1:condition}
	${0:body}
endif
endsnippet

snippet ife "If-else statement" b
if ${1:condition}
	${2:body}
else
	${0:body}
endif
endsnippet
