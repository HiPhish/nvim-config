snippet @header "Document header"
\input texinfo   @c -*-texinfo-*-
@c %**start of header
@settitle ${1:Document title}
@c %**end of header

@copying
Copyright @copyright{} ${2:year(s)}-${3:Author}

@quotation
Permission is granted to copy, distribute and/or modify this document
under the terms of the GNU Free Documentation License, Version 1.3
or any later version published by the Free Software Foundation;
with no Invariant Sections, no Front-Cover Texts, and no Back-Cover Texts.
A copy of the license is included in the section entitled "GNU
Free Documentation License".
@end quotation
@end copying
endsnippet


snippet @titlepage "Title page"
@titlepage
@title ${1: Title of the document}
@author ${2: Author name}

@page
@vskip 0pt plus 1filll
@insertcopying
@end titlepage
endsnippet

snippet @block "Generic block command"
@${1:command}
${0:Body}
@end $1
endsnippet

snippet @node "Document node"
@node ${1:title}
@${2:chapter} $1
endsnippet


snippet @menu "Node menu"
@menu
* ${1:Menu entry}:: ${2:Description}
@end menu
endsnippet


snippet @deffn "Definition"
@deffn {${1:Category}} ${2:name}
${0:body}
@end deffn
endsnippet
