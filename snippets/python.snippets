priority 100

# Module imports
snippet from "Selective import"
	from ${1:module} import ${2:symbol}

# Function definitions
snippet def "Function definition" b
	def ${1:function}(${2:arg}):
		${3:"""${4:Docstring}"""
		}${0:pass}

snippet defm "Method definition" b
	def ${1:method}(self, ${2:arg}):
		${3:"""${4:Docstring}"""
		}${0:pass}

snippet defi "Constructor definition" b
	def __init__(self, ${1:arg}):
		${0:pass}

# Class definitions
snippet class "Class definition"
	class ${1:name}${2:(${3:Object})}:
		${0:pass}

# Control flow
snippet if "Condition consequent"
	if ${1:condition}:
		${0:pass}

snippet elif "Condition alternative consequent"
	elif ${1:condition}:
		${0:pass}

snippet else "Condition alternative"
	else:
		${0:pass}

snippet while "While-loop"
	while ${1:condition}:
		${0:pass}

snippet for "For-loop" b
	for ${1:item} in ${2:items}:
		${0:pass}

snippet try "Try-except" b
	try:
		${1:pass}
	except ${2:${3Exception} as ${4:e}}:
		${5:pass}

snippet trye "Try-except-else" b
	try:
		${1:pass}
	except ${2:${3Exception} as ${4:e}}:
		${5:pass}
	else:
		${6:pass}

snippet tryf "Try-except-finally" b
	try:
		${1:pass}
	except ${2:${3Exception} as ${4:e}}:
		${5:pass}
	finally:
		${6:pass}

snippet tryef "Try-except-else-finally" b
	try:
		${1:pass}
	except ${2:${3Exception} as ${4:e}}:
		${5:pass}
	else:
		${6:pass}
	finally:
		${7:pass}

# Testing
snippet test "Test function" b
	def test_${1:description}(self${2:, ${3:arg}}) -> None:
		${0:pass}
